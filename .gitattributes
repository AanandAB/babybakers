# Images are binary — never convert line endings
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.gif binary
*.ico binary

# Force LF for code files committed from Windows
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
